PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/nexia_ai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
AI_WEB_SEARCH=false
AI_WEB_SEARCH_TIMEOUT_MS=20000
AI_TEXT_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2048
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=8
